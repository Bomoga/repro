{
  "name": "repro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p packages/web/tsconfig.json && tsc -p packages/site/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "dev": "npm run dev --workspace @repro/api",
    "dev:api": "npm run dev -w @repro/api",
    "control-plane": "npm run start --workspace @repro/orchestrator",
    "status": "npm run status --workspace @repro/cli",
    "cli": "node packages/cli/bin/repro.js",
    "seed": "npm run seed -w @repro/api",
    "web": "npm run dev --workspace @repro/web",
    "dev:web": "npm run dev -w @repro/web",
    "dev:site": "npm run dev -w @repro/site",
    "dev:all": "node scripts/dev-all.mjs",
    "demo": "node scripts/dev-all.mjs --control-plane",
    "sandbox:build": "docker build -t repro-sandbox:dev sandbox",
    "test:rules": "semgrep scan --test --metrics=off --disable-version-check sandbox/rules/privacy-patterns",
    "scan:lane2": "tsx scripts/lane2-scan.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "@repro/detect": "*",
    "@repro/executor": "*",
    "@repro/ingest": "*"
  }
}
