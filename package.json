{
  "name": "repro",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "sandbox:build": "docker build -t repro-sandbox:dev sandbox",
    "test:rules": "semgrep scan --test --metrics=off --disable-version-check sandbox/rules/privacy-patterns",
    "scan:lane2": "tsx scripts/lane2-scan.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "@repro/detect": "*",
    "@repro/executor": "*",
    "@repro/ingest": "*"
  }
}
