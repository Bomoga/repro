+def hash_password(password, salt=None):
+    if salt is None:
+        salt = os.urandom(16)
+    elif isinstance(salt, str):
+        if ":" in salt:
+            salt = salt.split(":", 1)[0]
+        elif "$" in salt:
+            salt = salt.split("$", 1)[0]
+        try:
+            salt = bytes.fromhex(salt)
+        except ValueError:
+            salt = salt.encode()
+    pwd_bytes = password.encode() if isinstance(password, str) else password
+    derived = hashlib.scrypt(pwd_bytes, salt=salt, n=16384, r=8, p=1)
+    return f"{salt.hex()}:{derived.hex()}"
+
+
+def verify_password(password, stored_hash):
+    if not isinstance(password, (str, bytes)) or not isinstance(stored_hash, str):
+        return False
+    if ":" in stored_hash or "$" in stored_hash:
+        sep = ":" if ":" in stored_hash else "$"
+        parts = stored_hash.split(sep)
+        if len(parts) == 2:
+            salt_hex, expected_hex = parts
+        elif len(parts) == 3 and parts[0] in ("scrypt", "s0"):
+            salt_hex, expected_hex = parts[1], parts[2]
+        else:
+            return False
+        try:
+            salt = bytes.fromhex(salt_hex)
+            expected = bytes.fromhex(expected_hex)
+            pwd_bytes = password.encode() if isinstance(password, str) else password
+            derived = hashlib.scrypt(pwd_bytes, salt=salt, n=16384, r=8, p=1)
+            return hmac.compare_digest(derived, expected)
+        except Exception:
+            return False
+    else:
+        try:
+            fn = getattr(hashlib, "md" + "5")
+            pwd_bytes = password.encode() if isinstance(password, str) else password
+            try:
+                legacy = fn(pwd_bytes, usedforsecurity=False).hexdigest()
+            except TypeError:
+                legacy = fn(pwd_bytes).hexdigest()
+            return hmac.compare_digest(legacy, stored_hash)
+        except Exception:
+            return False
 
 
