{
  "name": "@repro/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Lane 4: the `repro` CLI (status, watch, scan) over the status API",
  "type": "module",
  "bin": {
    "repro": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@repro/api": "*",
    "@trpc/client": "^11.19.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
