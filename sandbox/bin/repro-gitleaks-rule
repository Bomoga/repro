#!/usr/bin/env python3
"""Re-run exactly one gitleaks rule against exactly one file, redacted.

Usage: repro-gitleaks-rule <rule-id> <file>

The reproductionCommand for every gitleaks Finding. Same exit-code protocol as
repro-semgrep-rule (1 reproduced, 0 not, 2 undecided). gitleaks always runs with --redact and
Repro's own config and ignore path, and only locations plus gitleaks' redacted Match are printed.
"""
import json
import os
import subprocess
import sys
import tempfile

CONFIG = "/opt/repro/gitleaks/gitleaks.toml"
IGNORE_DIR = "/opt/repro/gitleaks/no-ignore"


def fail(msg: str) -> None:
    print(f"repro-gitleaks-rule: {msg}", file=sys.stderr)
    sys.exit(2)


def main() -> None:
    if len(sys.argv) != 3:
        fail("usage: repro-gitleaks-rule <rule-id> <file>")
    rule_id, target = sys.argv[1:]
    if not os.path.isfile(target):
        print(f"NOT REPRODUCED gitleaks {rule_id} in {target}: file no longer exists")
        sys.exit(0)

    with tempfile.TemporaryDirectory() as tmp:
        report_path = os.path.join(tmp, "report.json")
        proc = subprocess.run(
            [
                "gitleaks", "dir", target,
                "--redact", "--no-banner", "--log-level", "error",
                "--config", CONFIG,
                "--gitleaks-ignore-path", IGNORE_DIR,
                "--enable-rule", rule_id,
                "--report-format", "json", "--report-path", report_path,
                "--exit-code", "0",
            ],
            capture_output=True,
            text=True,
        )
        if proc.returncode != 0 or not os.path.exists(report_path):
            fail(f"gitleaks exited {proc.returncode}: {proc.stderr[-2000:]}")
        with open(report_path) as fh:
            leaks = json.load(fh) or []

    leaks = [l for l in leaks if l.get("RuleID") == rule_id]
    for leak in leaks:
        # Belt and braces on top of --redact: never print a Secret gitleaks failed to redact.
        match = leak.get("Match", "")
        secret = leak.get("Secret", "")
        if secret and secret != "REDACTED":
            match = match.replace(secret, "REDACTED")
        path = leak.get("File", target)
        print(f"REPRODUCED gitleaks {rule_id} at {path}:{leak['StartLine']}-{leak['EndLine']}: {match}")
    if leaks:
        sys.exit(1)
    print(f"NOT REPRODUCED gitleaks {rule_id} in {target}")
    sys.exit(0)


if __name__ == "__main__":
    main()
