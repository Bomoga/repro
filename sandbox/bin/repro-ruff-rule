#!/usr/bin/env python3
"""Re-run exactly one Ruff rule against exactly one file.

Usage: repro-ruff-rule <code> <file>

The reproductionCommand for every Ruff Finding. Same protocol as repro-semgrep-rule: exit 1 with a
"REPRODUCED ..." line per match, exit 0 with "NOT REPRODUCED ...", exit 2 when it couldn't decide.
Like the scan, it runs --isolated (the target's own Ruff config can't turn rules off) and with
--ignore-noqa (its `# noqa` comments can't hide them). Line-agnostic, so it stays valid after a
patch moves lines.
"""
import json
import os
import re
import subprocess
import sys


def fail(msg: str) -> None:
    print(f"repro-ruff-rule: {msg}", file=sys.stderr)
    sys.exit(2)


def main() -> None:
    if len(sys.argv) != 3:
        fail("usage: repro-ruff-rule <code> <file>")
    code, target = sys.argv[1:]
    if not re.fullmatch(r"[A-Z]+[0-9]+", code):
        fail(f"not a Ruff rule code: {code!r}")
    if not os.path.isfile(target):
        print(f"NOT REPRODUCED ruff {code} in {target}: file no longer exists")
        sys.exit(0)
    proc = subprocess.run(
        ["ruff", "check", "--select", code, "--output-format", "json", "--isolated", "--no-cache",
         "--ignore-noqa", "--exit-zero", "--", target],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        fail(f"ruff exited {proc.returncode}: {proc.stderr[-2000:]}")
    try:
        results = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError:
        fail(f"ruff produced no JSON report: {proc.stderr[-2000:]}")
    results = [r for r in results if r.get("code") == code]
    cwd = os.getcwd() + os.sep
    for r in results:
        path = r["filename"][len(cwd):] if r["filename"].startswith(cwd) else r["filename"]
        message = " ".join(r["message"].split())[:300]
        print(f"REPRODUCED ruff {code} at {path}:{r['location']['row']}-{r['end_location']['row']}: {message}")
    if results:
        sys.exit(1)
    print(f"NOT REPRODUCED ruff {code} in {target}")
    sys.exit(0)


if __name__ == "__main__":
    main()
