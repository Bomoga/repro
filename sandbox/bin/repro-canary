#!/usr/bin/env python3
"""Reproduce a privacy-patterns Finding by watching it happen, not by re-matching the code.

Usage: repro-canary <check> <file> <function> <line> [<semgrep-pack> <rule-id>]

Calls <function> from <file> with a fresh, unique canary string as the user input (see
repro-canary-py and repro-canary-js.cjs for how arguments are chosen), then looks for the canary in
the sink this check is about:
  prompt-logging                    log records, console output, stdout/stderr, *.log files
  unencrypted-conversation-storage  files written in plaintext, localStorage/sessionStorage
  third-party-forwarding            an outbound request (URL, headers, or body) to a host that isn't a
                                    model provider
  analytics-forwarding              an outbound request (URL, headers, or body) to any host
Outbound requests are intercepted and recorded, never sent (and the sandbox has no network anyway):
the point is proving the code tried to send the canary, not sending it. The harnesses capture the
common HTTP clients above TLS; any other way the function reaches the network is recorded as an
attempt whose payload couldn't be seen, and for the forwarding checks that means it can't tell, never
"the canary wasn't sent".

Same exit protocol as the other repro-* helpers, with <line> (the Finding's line at detect time)
printed in the REPRODUCED line:
  exit 1  "REPRODUCED ..."       the canary reached the sink
  exit 0  "NOT REPRODUCED ..."   the function ran to completion and the canary didn't
  exit 2  reason on stderr       it couldn't tell: the function couldn't be loaded or called, it
                                 failed before the canary showed up anywhere, or (forwarding checks)
                                 it reached the network in a way the harness can't see into. Never
                                 read as "fixed".

With <semgrep-pack> <rule-id>, a run that can't tell falls back to re-running that Semgrep rule on
the file (repro-semgrep-rule), after a line saying the canary couldn't decide: a Finding the canary
can't exercise keeps the static reproduction it had, and its output says which kind of proof it is.
One exception: when the function still reached the network in a way the canary couldn't see into,
the rule no longer matching doesn't make it fixed (sending the data some other way isn't a fix), so
that ends in exit 2 as well.
"""
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tempfile

from repro_venv import activated_env, python_in, trusted_venv

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.getcwd()
VENV = trusted_venv(ROOT)
CHECKS = {"prompt-logging", "unencrypted-conversation-storage", "third-party-forwarding", "analytics-forwarding"}
SKIP_DIRS = {".git", "node_modules", ".repro", "__pycache__"}
MODEL_PROVIDERS = re.compile(
    r"^(api\.openai\.com|api\.anthropic\.com|generativelanguage\.googleapis\.com|[a-z0-9-]+\.openai\.azure\.com|"
    r"api\.mistral\.ai|api\.cohere\.(ai|com)|api\.groq\.com|localhost|127\.0\.0\.1)(:\d+)?$"
)


# Set when the function reached the network in a way the harness couldn't see into.
UNSEEN = False


def fail(msg: str, unseen: bool = False) -> None:
    global UNSEEN
    UNSEEN = UNSEEN or unseen
    print(f"repro-canary: {msg}", file=sys.stderr)
    sys.exit(2)


def snapshot():
    seen = {}
    for base in (ROOT, "/tmp"):
        for dirpath, dirnames, filenames in os.walk(base):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
            seen[dirpath + os.sep] = None
            for name in filenames:
                path = os.path.join(dirpath, name)
                try:
                    st = os.stat(path)
                    seen[path] = (st.st_mtime_ns, st.st_size)
                except OSError:
                    pass
    return seen


def read(path, limit=1_000_000):
    try:
        with open(path, "rb") as fh:
            return fh.read(limit).decode("utf-8", "replace")
    except OSError:
        return ""


def show(text, canary, limit=160):
    return " ".join(text.replace(canary, "<canary>").split())[:limit]



def main():
    if len(sys.argv) not in (5, 7):
        fail("usage: repro-canary <check> <file> <function> <line> [<semgrep-pack> <rule-id>]")
    fallback = sys.argv[5:7]
    try:
        run(*sys.argv[1:5])
    except SystemExit as done:
        if done.code == 2 and fallback:
            print("canary tracing couldn't decide here; falling back to re-running the Semgrep rule", flush=True)
            proc = subprocess.run(["repro-semgrep-rule", fallback[0], fallback[1], sys.argv[2]], capture_output=True, text=True)
            sys.stdout.write(proc.stdout)
            sys.stderr.write(proc.stderr)
            if UNSEEN and proc.returncode == 0:
                print("repro-canary: the Semgrep rule no longer matches, but the function still reaches the network in a "
                      "way the canary can't see into, so it can't be called fixed", file=sys.stderr)
                sys.exit(2)
            sys.exit(proc.returncode)
        raise


def run(check, target, function, line):
    if check not in CHECKS:
        fail(f"unknown check {check!r}")
    if not re.fullmatch(r"[A-Za-z_$][\w$]*", function):
        fail(f"not a function name: {function!r}")
    if not os.path.isfile(target):
        print(f"NOT REPRODUCED canary {check} in {target}: file no longer exists")
        sys.exit(0)
    if target.endswith(".py"):
        # Under the venv Repro installed the target's dependencies into, when it can trust one.
        harness = [python_in(VENV), os.path.join(HERE, "repro-canary-py")]
    elif re.search(r"\.(c|m)?js$", target):
        harness = ["node", os.path.join(HERE, "repro-canary-js.cjs")]
    else:
        fail(f"canary tracing doesn't run {os.path.splitext(target)[1]} files")

    canary = "REPROCANARY" + secrets.token_hex(8)
    workdir = tempfile.mkdtemp(prefix="repro-canary-run-")
    report_path = os.path.join(workdir, "report.json")
    before = snapshot()
    try:
        proc = subprocess.run(harness + [target, function, canary, report_path], capture_output=True, text=True, timeout=60, cwd=ROOT,
                              env=activated_env(VENV))
    except subprocess.TimeoutExpired:
        fail("the harness timed out")
    after = snapshot()
    written = [p for p, stamp in after.items() if stamp is not None and before.get(p) != stamp and not p.startswith(workdir)]
    new_dirs = sorted((p for p in after if after[p] is None and p not in before), key=len, reverse=True)
    try:
        with open(report_path) as fh:
            report = json.load(fh)
    except (OSError, ValueError):
        fail(f"the harness produced no report (exit {proc.returncode}): {(proc.stderr or proc.stdout)[-1000:]}")
    finally:
        shutil.rmtree(workdir, ignore_errors=True)

    hits = []
    unseen = []
    if check == "prompt-logging":
        hits += [f'canary reached the logs: "{show(l, canary)}"' for l in report.get("logs", []) if canary in l]
        hits += [f"canary written to log file {os.path.relpath(p, ROOT) if p.startswith(ROOT) else p}"
                 for p in written if (p.endswith(".log") or "/log" in p) and canary in read(p)]
    elif check == "unencrypted-conversation-storage":
        hits += [f"canary written in plaintext to {os.path.relpath(p, ROOT) if p.startswith(ROOT) else p}"
                 for p in written if not p.endswith(".log") and canary in read(p)]
        hits += [f'canary stored in plaintext in {s["store"]}["{s["key"]}"]' for s in report.get("storage", []) if canary in s.get("value", "")]
    else:
        # Analytics counts any host; for third-party forwarding, a model provider isn't a third party.
        def counts(host):
            return check == "analytics-forwarding" or not MODEL_PROVIDERS.match(host)

        for r in report.get("requests", []):
            host = r.get("host") or ""
            sent = f"{r.get('url') or ''}\n{r.get('payload') or ''}"
            if r.get("captured", True) and canary in sent and counts(host):
                hits.append(f"canary sent to {host or r.get('url')}")
        unseen = sorted({r.get("host") or "?" for r in report.get("requests", []) if not r.get("captured", True) and counts(r.get("host") or "")})

    # Clean up what this call created, so the next run starts the same: new files carrying this
    # run's canary (nothing else can contain it), then any directories left empty. Other files are
    # left alone, in case something else is working in the same workspace.
    for p in written:
        if p not in before and (p.startswith(ROOT + os.sep) or p.startswith("/tmp/")) and canary in read(p):
            try:
                os.remove(p)
            except OSError:
                pass
    for d in new_dirs:
        if d.startswith(ROOT + os.sep) or d.startswith("/tmp/"):
            try:
                os.rmdir(d)
            except OSError:
                pass
    shutil.rmtree("/tmp/repro-canary", ignore_errors=True)

    if hits:
        for hit in dict.fromkeys(hits):
            print(f"REPRODUCED canary {check} at {target}:{line}-{line}: {hit}")
        print(f"called {function}() in {target} with a unique canary as the user input")
        sys.exit(1)
    if unseen:
        fail(f"{function}() in {target} reached for {', '.join(unseen)}, but not through a client the canary can see "
             "the payload of, so it can't tell whether the canary was sent", unseen=True)
    if report.get("called") and report.get("returned"):
        print(f"NOT REPRODUCED canary {check} in {target}: {function}() ran and the canary never reached that sink")
        sys.exit(0)
    fail(f"couldn't observe {function}() in {target}: {report.get('error') or 'it never ran'}")


if __name__ == "__main__":
    main()
